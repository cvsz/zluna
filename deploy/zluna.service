[Unit]
Description=zluna (Lunaland Next-Gen) fake-credit realtime simulator & casino engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cvsz
Group=cvsz
WorkingDirectory=/home/cvsz/zluna
ExecStart=/usr/bin/python3 /home/cvsz/zluna/src/app.py
Environment=ZLUNA_HOST=127.0.0.1
Environment=ZLUNA_PORT=9581
Environment=ZLUNA_DATA_PATH=/home/cvsz/zluna/data/events.jsonl
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/cvsz/zluna/data

[Install]
WantedBy=multi-user.target
