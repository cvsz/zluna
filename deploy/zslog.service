[Unit]
Description=zslog fake-credit realtime simulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cvsz
Group=cvsz
WorkingDirectory=/home/cvsz/zslog
ExecStart=/usr/bin/python3 /home/cvsz/zslog/app.py
Environment=ZSLOG_HOST=127.0.0.1
Environment=ZSLOG_PORT=9581
Environment=ZSLOG_DATA_PATH=/home/cvsz/zslog/data/events.jsonl
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/cvsz/zslog/data

[Install]
WantedBy=multi-user.target
